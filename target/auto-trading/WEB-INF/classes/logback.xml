<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <!-- Default to WARN for app logs; allow StrategyEngine BUY/SELL INFO only -->
    <logger name="com.autotrading" level="WARN"/>
    <logger name="com.autotrading.strategy.StrategyEngine" level="INFO"/>
    <logger name="com.autotrading.scheduler.SchedulerService" level="INFO"/>
    <logger name="com.autotrading.order.OrderService" level="INFO"/>
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
